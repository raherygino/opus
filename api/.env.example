# OPUS API environment configuration — copy to `.env` and adjust values.

# Application
APP_DEBUG=false
JWT_SECRET=opus-secret-key-change-in-production

# Database (values read by api/config/database.php)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=opus
DB_USER=root
DB_PASS=

# Firebase Cloud Messaging push notifications
FCM_ENABLED=true
